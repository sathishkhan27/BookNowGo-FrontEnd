# Backend API URL
# Leave empty for local development (uses Vite proxy to http://localhost:8080)
# Set to your hosted backend URL when deploying to Render (e.g., https://booknowgo-backend.onrender.com)
VITE_API_URL=

# Neon Database Storage Configuration
# Set these in your local .env or Render Dashboard > Environment Variables
NEON_API_KEY=
VITE_NEON_PROJECT_ID=
VITE_NEON_BRANCH_ID=
VITE_NEON_BUCKET_NAME=
VITE_NEON_STORAGE_ENDPOINT=
